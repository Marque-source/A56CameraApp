<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Windows 7 Harmony Sky Blue Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF006699"
                android:centerColor="#FF003B64"
                android:endColor="#FF001830"
                android:type="linear" />
        </shape>
    </item>
    <!-- Windows 7 Bottom-Right Green Light Swirl Flare -->
    <item android:gravity="bottom|end">
        <shape android:shape="oval">
            <size android:width="320dp" android:height="320dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:startColor="#5076C043"
                android:centerColor="#2034A853"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
