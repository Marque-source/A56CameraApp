<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- GENEL AYARLAR -->
    <PreferenceCategory
        android:title="Kamera Tercihleri"
        android:layout="@layout/preference_category_frutiger">

        <SwitchPreferenceCompat
            android:key="pref_capture_sound"
            android:title="Deklanşör Sesi"
            android:defaultValue="true"
            android:layout="@layout/preference_item_frutiger" />

        <SwitchPreferenceCompat
            android:key="pref_volume_capture"
            android:title="Ses Tuşları ile Çekim"
            android:summary="Ses artırma/azaltma tuşu ile fotoğraf çek"
            android:defaultValue="true"
            android:layout="@layout/preference_item_frutiger" />

        <SwitchPreferenceCompat
            android:key="pref_location_tagging"
            android:title="Konum Etiketi"
            android:summary="Fotoğrafların EXIF verisine GPS konumunu kaydet"
            android:defaultValue="false"
            android:layout="@layout/preference_item_frutiger" />

        <ListPreference
            android:key="pref_grid"
            android:title="Izgara Çizgileri"
            android:entries="@array/grid_entries"
            android:entryValues="@array/grid_values"
            android:defaultValue="off"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_item_frutiger" />

        <SwitchPreferenceCompat
            android:key="pref_histogram"
            android:title="Canlı Histogram"
            android:summary="Vizör üzerinde canlı RGB/Luma dağılım grafiği göster"
            android:defaultValue="false"
            android:layout="@layout/preference_item_frutiger" />
    </PreferenceCategory>

    <!-- VİDEO AYARLARI -->
    <!-- Çözünürlük, kare hızı ve sabitleme video modundaki hızlı ayarlar panelinden seçilir.
         (Eskiden burada hiçbir şeyi değiştirmeyen "Video Çözünürlüğü" ve "Video Sabitleme" vardı;
         kodun okuduğu codec ve time-lapse aralığı ise hiç gösterilmiyordu.) -->
    <PreferenceCategory
        android:title="Video"
        android:layout="@layout/preference_category_frutiger">

        <ListPreference
            android:key="pref_video_codec"
            android:title="Video Kodlayıcı"
            android:entries="@array/video_codec_entries"
            android:entryValues="@array/video_codec_values"
            android:defaultValue="h264"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_item_frutiger" />

        <ListPreference
            android:key="pref_timelapse_interval"
            android:title="Hızlandırılmış Çekim Aralığı"
            android:entries="@array/timelapse_interval_entries"
            android:entryValues="@array/timelapse_interval_values"
            android:defaultValue="1"
            app:useSimpleSummaryProvider="true"
            android:layout="@layout/preference_item_frutiger" />
    </PreferenceCategory>

</PreferenceScreen>
